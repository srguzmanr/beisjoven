---
// HOUSE-ADS-01 — AdSlot: position-agnostic, reusable ad container.
// Creatives are served from the `anuncios` table (CMS-managed). The slot
// reserves a 300×250 box (aspect-ratio) so it NEVER collapses and CLS = 0.
//
// Disclosure labels are CLOSED by Legal (HOUSE-ADS-LEGAL-01) and live in ONE
// place: src/lib/ad-disclosure.js. The label is clear-and-conspicuous:
// rendered at the same time as the creative (never behind hover/click), AA
// contrast, all devices.
import { getAnunciosBySlot, type Anuncio, type AnuncioTipo } from '@/lib/supabase';
import { buildAdHref } from '@/lib/ad-utm.js';
import { labelForCreative, canServeCreative, EMPTY_SLOT_NOTICE } from '@/lib/ad-disclosure.js';

interface Props {
  /** Frozen nomenclature (ADS-GOLIVE-PREP-01):
      'home-top' (homepage leaderboard) | 'home-mid' (homepage in-feed MPU)
      | 'article-body' (in-article MPU) | 'article-footer' (end-of-note). */
  slotId: string;
  /** Layout footprint: 'prose' (article-body) or 'card' (home-mid). Cosmetic only.
      mpu-only. */
  variant?: 'prose' | 'card';
  /** Ad format: 'mpu' 300×250 (default) | 'leaderboard' responsive
      970×90 desktop / 320×50 mobile (home-top, LEADER-01). */
  format?: 'mpu' | 'leaderboard';
}

const { slotId, variant = 'card', format = 'mpu' } = Astro.props;

// ADS-STD-01 — placeholder pattern (LEADER-01): non-promotional,
// dimensions-only copy. Same string in ES and EN, like the leaderboard.
const MPU_PH_TEXT = 'Espacio publicitario · 300 × 250';

// --- Select the creative to serve -------------------------------------------
// ADS-STD-01 waterfall: paid (propia/aliado) > casa. Only servable creatives
// compete; the highest non-empty tier wins. MPU rotates randomly ONLY within
// the winning tier; leaderboard stays deterministic — lowest prioridad in the
// tier (pool keeps the prioridad-asc order from getAnunciosBySlot).
//
// ADS-DISCLOSURE-01 — "servable" now means image + destination + a Legal-
// approved disclosure label. The gate sits here, at selection, so a creative
// without an approved label can never be chosen and therefore can never
// render: not unlabelled, not with a blank label, not with a generic
// fallback. The slot falls through to the next tier and, if none qualifies,
// to the empty state below — so the box is still reserved and CLS stays 0.
//
// `propia` keeps its tier-1 seat deliberately: it is non-servable today only
// because ad-disclosure.js has no entry for it. Adding that entry is the
// single lever that puts it back in rotation. `placeholder` is NOT a tier —
// it is the empty state, reached by having no chosen creative at all.
let chosen: Anuncio | null = null;
const anuncios = await getAnunciosBySlot(slotId);
const servable = anuncios.filter(
  (a) => a.imagen_url && a.target_url && canServeCreative(a.tipo)
);
const tiers: AnuncioTipo[][] = [['propia', 'aliado'], ['casa']];
const pool = tiers
  .map((tier) => servable.filter((a) => tier.includes(a.tipo)))
  .find((p) => p.length > 0);
if (pool) {
  chosen = format === 'leaderboard'
    ? pool[0]
    : pool[Math.floor(Math.random() * pool.length)];
}

// Second fail-closed gate, same source of truth. Unreachable while the filter
// above stands; it stays so the invariant survives an edit to the selection
// logic. A creative without an approved label is DROPPED, never relabelled.
const creativeLabel = chosen ? labelForCreative(chosen.tipo) : null;
if (chosen && creativeLabel === null) chosen = null;

const hasCreative = chosen !== null;
const tipo: AnuncioTipo = hasCreative ? chosen!.tipo : 'placeholder';
// Creative → its approved disclosure. No creative → the unsold-inventory
// notice, which is not a disclosure (see EMPTY_SLOT_NOTICE).
const label = hasCreative ? creativeLabel! : EMPTY_SLOT_NOTICE;
const anunciante = hasCreative ? chosen!.marca ?? chosen!.tipo : 'placeholder';
// ADS-GOLIVE-PREP-01 — outbound UTMs, built server-side so the cached HTML is
// already tagged. Paid tipos only (propia/aliado); casa/placeholder stay
// clean. utm_* already present in target_url is never duplicated (DB wins).
const href = hasCreative
  ? buildAdHref(chosen!.target_url!, tipo, chosen!.campana ?? null, slotId)
  : '';
const isExternal = href.startsWith('http');
// Leaderboard art direction: mobile creative falls back to the desktop asset
// (letterboxed via object-fit: contain) until imagen_url_mobile is set.
const mobileSrc = chosen?.imagen_url_mobile ?? chosen?.imagen_url ?? null;
---

{format === 'leaderboard' ? (
  /* LEADER-01 — responsive leaderboard: 970×90 ≥768px / 320×50 <768px.
     Always active; height reserved in CSS (aspect-ratio) so CLS = 0. */
  <aside
    class="bj-adslot bj-adslot--leaderboard"
    aria-label={label}
    data-ad-slot={slotId}
    data-ad-active="true"
    data-ad-tipo={tipo}
    data-ad-anunciante={anunciante}
    data-ad-id={chosen?.id}
  >
    <div class="bj-lb__unit">
      <span class="bj-adslot__label bj-adslot__label--lb">{label}</span>
      {hasCreative ? (
        <a
          class="bj-lb__frame"
          href={href}
          data-ad-cta
          target="_blank"
          rel="sponsored noopener"
        >
          <picture class="bj-lb__picture">
            <source media="(min-width: 768px)" srcset={chosen!.imagen_url!} width="970" height="90" />
            <img
              class="bj-lb__img"
              src={mobileSrc}
              alt={chosen!.alt_text}
              width="320"
              height="50"
              loading="eager"
              decoding="async"
            />
          </picture>
        </a>
      ) : (
        <div class="bj-lb__frame bj-lb__frame--ph">
          <span class="bj-lb__ph bj-lb__ph--mobile">Espacio publicitario · 320 × 50</span>
          <span class="bj-lb__ph bj-lb__ph--desktop">Espacio publicitario · 970 × 90</span>
        </div>
      )}
    </div>
  </aside>
) : (
  <aside
    class:list={['bj-adslot', `bj-adslot--${variant}`]}
    aria-label={label}
    data-ad-slot={slotId}
    data-ad-active="true"
    data-ad-tipo={tipo}
    data-ad-anunciante={anunciante}
    data-ad-id={chosen?.id}
  >
    <span class="bj-adslot__label">{label}</span>
    {hasCreative ? (
      <a
        class="bj-adslot__frame"
        href={href}
        data-ad-cta
        {...isExternal ? { target: '_blank', rel: 'noopener sponsored' } : {}}
      >
        <img
          class="bj-adslot__img"
          src={chosen!.imagen_url!}
          alt={chosen!.alt_text}
          width="300"
          height="250"
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <div class="bj-adslot__frame bj-adslot__frame--ph">
        <span class="bj-adslot__ph">{MPU_PH_TEXT}</span>
      </div>
    )}
  </aside>
)}

<style>
  /* Neutral / navy frame — NEVER a category color. */
  /* ADS-AIR-02 — gap 6 → 4: acerca el rótulo a lo que rotula (la proximidad
     del disclosure mejora, no empeora) y se queda en la banda inline 4–8 de la
     Spec v1.1. Aplica a las tres variantes. */
  .bj-adslot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin: 0 auto;
    width: 100%;
  }

  /* ADS-AIR-01 — la unidad in-column comparte borde izquierdo con la columna
     de texto. Antes, `margin: 0 auto` + `align-items: center` (heredados de
     .bj-adslot) centraban una unidad de 300px dentro de una columna más ancha:
     medido en el CSS servido, eso metía 21.5px de aire a cada lado a 375 y
     218px a 768 en article-body / article-footer, y hacía que el bloque
     arrancara más a la derecha que el cuerpo del artículo. El ancho de la
     unidad NO cambia (300×250): solo deja de estar centrada. Las variantes
     --card y --leaderboard conservan el centrado: son items de banda
     full-bleed, no elementos dentro de una columna de lectura. */
  .bj-adslot--prose {
    max-width: var(--max-width-prose, 42rem);
    margin: 0;
    align-items: flex-start;
  }

  /* ADS-STD-01 — label sits directly above the unit, flush with the unit's
     left edge: same 300px cap as the frame, so label and creative share a
     left edge whatever the column does with the pair (ADS-AIR-01: centered
     in --card / --leaderboard, flush with the text column in --prose). */
  /* ADS-AIR-02 — line-height propio. El rótulo es un overline de manual (11px,
     700, mayúsculas, tracking 0.08em) y heredaba el 1.7 de `body`: 7.7px de
     interlineado de PÁRRAFO sobre una micro-etiqueta de una línea, que a 375
     inflaban su caja a 18.7px y se comían un tercio del bloque publicitario.
     --lh-overline (1.4) es el token que la Spec v1.1 asigna a ese rol → caja
     de 15.4px. Nada de lo que gobierna un disclosure cambia: mismo texto,
     mismo tamaño de glifo, mismo peso, mismo #4B5563 (≈7:1 sobre blanco).
     Compartido a propósito por los cuatro slots — era el mismo defecto de
     herencia en las cuatro superficies. */
  .bj-adslot__label {
    text-align: left;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 11px;
    font-weight: 700;
    line-height: var(--lh-overline, 1.4);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* AA contrast on white: #4B5563 ≈ 7:1 */
    color: #4B5563;
    max-width: 300px;
    width: 100%;
  }

  .bj-adslot__frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 300px;
    max-width: 100%;
    /* Reserve the box → CLS = 0 even before the lazy image loads. */
    aspect-ratio: 300 / 250;
    border: 1px solid var(--rule-strong, rgba(27, 42, 74, 0.28));
    background: var(--bg-2, #F6F5F1);
    overflow: hidden;
    text-decoration: none;
  }

  .bj-adslot__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ADS-STD-01 — MPU placeholder, LEADER-01 pattern: neutral box, 1px
     var(--rule) border, centered dimensions-only copy in navy @ 60%. */
  .bj-adslot__frame--ph {
    border-color: var(--rule, rgba(27, 42, 74, 0.10));
  }

  .bj-adslot__ph {
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 12px;
    line-height: 1.2;
    text-align: center;
    padding: 12px;
    /* navy @ 60% */
    color: rgba(27, 42, 74, 0.6);
  }

  /* --- LEADER-01 — leaderboard format (970×90 / 320×50) ------------------- */
  /* The frame reserves its box via width + aspect-ratio per breakpoint, so
     height is CSS-determined before any image byte arrives → CLS = 0. */

  /* HYGIENE-01 — the unit column (label + frame) shrink-wraps the served
     creative so the disclosure label stays flush with the unit's real left
     edge (ADS-STD-01) even when the creative is narrower than the slot. */
  .bj-lb__unit {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
  }

  .bj-adslot__label--lb {
    max-width: 320px;
  }

  .bj-lb__frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 320px;
    max-width: 100%;
    aspect-ratio: 320 / 50;
    border: 1px solid var(--rule, rgba(27, 42, 74, 0.10));
    background: var(--bg-2, #F6F5F1);
    overflow: hidden;
    text-decoration: none;
  }

  .bj-lb__picture {
    width: 100%;
    height: 100%;
    display: block;
  }

  .bj-lb__img {
    width: 100%;
    height: 100%;
    /* contain, not cover: a 970×90 asset serving as mobile fallback would
       lose ~40% of its width to cropping; letterboxing keeps it legible. */
    object-fit: contain;
    display: block;
  }

  .bj-lb__ph {
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 12px;
    line-height: 1.2;
    text-align: center;
    /* navy @ 60% */
    color: rgba(27, 42, 74, 0.6);
  }

  .bj-lb__ph--desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .bj-adslot__label--lb {
      max-width: 970px;
    }

    /* 768–1010px viewports: max-width:100% shrinks the box, aspect-ratio
       scales the height proportionally — still zero shift. */
    .bj-lb__frame {
      width: 970px;
      aspect-ratio: 970 / 90;
    }

    /* HYGIENE-01 — sin letterbox: cuando hay creativo, el frame deja de
       pintar chrome (caja fija invisible, altura reservada 90px → CLS 0)
       y el borde/fondo viven en la imagen, que se dibuja a su proporción
       natural. Un creativo que no sea exactamente 970:90 queda centrado
       y abrazado por su borde, sin bandas laterales. El placeholder
       (--ph) conserva la caja fija con chrome. */
    .bj-lb__frame:not(.bj-lb__frame--ph) {
      width: auto;
      height: 90px;
      aspect-ratio: auto;
      border: 0;
      background: transparent;
    }

    .bj-lb__frame:not(.bj-lb__frame--ph) .bj-lb__picture {
      width: auto;
      height: auto;
      max-width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .bj-lb__frame:not(.bj-lb__frame--ph) .bj-lb__img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 90px;
      border: 1px solid var(--rule, rgba(27, 42, 74, 0.10));
      background: var(--bg-2, #F6F5F1);
    }

    .bj-lb__ph--mobile {
      display: none;
    }

    .bj-lb__ph--desktop {
      display: inline;
    }
  }
</style>

<script is:inline>
  // HOUSE-ADS-01 — GA4 instrumentation for live ad slots.
  // ad_impression fires once when the slot enters the viewport; ad_click on
  // click. Payload: slot_id, tipo, anunciante.
  //
  // ADS-TRACK-01 — first-party beacons to POST /api/ad-event, IN ADDITION to
  // (and without touching) the GA4 events above:
  //   impression : once per slot+path per tab session (sessionStorage flag,
  //                so a reload does NOT double-count) — fired on render.
  //   viewable   : IAB display standard — >=50% of the unit visible
  //                continuously for >=1s; same sessionStorage dedupe as
  //                impression so viewable_rate can never exceed 100%.
  //   click      : every click on the creative CTA.
  // Transport: sendBeacon (survives the click navigation) with
  // fetch-keepalive fallback. Tracking must never break the page: every
  // entry point is try/caught and failures are silent.
  (function () {
    if (window.__bjAdSlotInit) return;
    window.__bjAdSlotInit = true;

    var VIEWABLE_MS = 1000;

    function emit(name, el) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', name, {
        slot_id: el.getAttribute('data-ad-slot'),
        tipo: el.getAttribute('data-ad-tipo'),
        anunciante: el.getAttribute('data-ad-anunciante'),
      });
    }

    function beacon(el, evento) {
      try {
        var payload = JSON.stringify({
          slot_id: el.getAttribute('data-ad-slot'),
          anuncio_id: el.getAttribute('data-ad-id') || null,
          evento: evento,
          path: location.pathname,
        });
        var sent = false;
        if (navigator.sendBeacon) {
          sent = navigator.sendBeacon(
            '/api/ad-event',
            new Blob([payload], { type: 'application/json' })
          );
        }
        if (!sent) {
          fetch('/api/ad-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: payload,
            keepalive: true,
          }).catch(function () {});
        }
      } catch (e) { /* never let tracking break the page */ }
    }

    // sessionStorage dedupe per evento+slot+path. If storage is unavailable
    // (private mode quotas), count rather than drop.
    function once(el, evento) {
      try {
        var key = 'bj_ad:' + evento + ':' + el.getAttribute('data-ad-slot') + ':' + location.pathname;
        if (sessionStorage.getItem(key)) return false;
        sessionStorage.setItem(key, '1');
        return true;
      } catch (e) {
        return true;
      }
    }

    function alreadySent(el, evento) {
      try {
        return !!sessionStorage.getItem(
          'bj_ad:' + evento + ':' + el.getAttribute('data-ad-slot') + ':' + location.pathname
        );
      } catch (e) {
        return false;
      }
    }

    function init() {
      var slots = document.querySelectorAll('.bj-adslot[data-ad-active="true"]');
      if (!slots.length) return;

      var io = 'IntersectionObserver' in window
        ? new IntersectionObserver(function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                emit('ad_impression', entry.target);
                obs.unobserve(entry.target);
              }
            });
          }, { threshold: 0.5 })
        : null;

      // ADS-TRACK-01 — viewability: a second observer (the GA4 one above
      // unobserves on first intersect, so it cannot measure a 1s dwell).
      var pending = [];
      var vio = 'IntersectionObserver' in window
        ? new IntersectionObserver(function (entries, obs) {
            entries.forEach(function (entry) {
              var el = entry.target;
              // 1e-3 epsilon: crossing the 0.5 threshold can report a ratio a
              // hair under it.
              var inView = entry.intersectionRatio >= 0.5 - 1e-3;
              el.__bjInView = inView;
              if (inView && !el.__bjViewTimer && !document.hidden) {
                el.__bjViewTimer = setTimeout(function () {
                  el.__bjViewTimer = null;
                  if (once(el, 'viewable')) beacon(el, 'viewable');
                  obs.unobserve(el);
                }, VIEWABLE_MS);
                pending.push(el);
              } else if (!inView && el.__bjViewTimer) {
                clearTimeout(el.__bjViewTimer);
                el.__bjViewTimer = null;
              }
            });
          }, { threshold: 0.5 })
        : null;

      // A hidden tab is not viewable (IO does not fire on tab switches):
      // cancel dwell timers on hide, restart them for still-in-view slots on
      // return.
      document.addEventListener('visibilitychange', function () {
        pending.forEach(function (el) {
          if (document.hidden && el.__bjViewTimer) {
            clearTimeout(el.__bjViewTimer);
            el.__bjViewTimer = null;
          } else if (!document.hidden && el.__bjInView && !el.__bjViewTimer && !alreadySent(el, 'viewable')) {
            el.__bjViewTimer = setTimeout(function () {
              el.__bjViewTimer = null;
              if (once(el, 'viewable')) beacon(el, 'viewable');
              if (vio) vio.unobserve(el);
            }, VIEWABLE_MS);
          }
        });
      });

      slots.forEach(function (el) {
        if (el.__bjAdBound) return;
        el.__bjAdBound = true;
        if (io) io.observe(el);
        else emit('ad_impression', el); // no IO support → count on render

        // ADS-TRACK-01 — impression on render, deduped across reloads.
        if (once(el, 'impression')) beacon(el, 'impression');
        // Viewability needs IO; without support we deliberately record no
        // viewable (never overstate the metric the advertiser pays against).
        if (vio && !alreadySent(el, 'viewable')) vio.observe(el);

        var cta = el.querySelector('[data-ad-cta]');
        if (cta) {
          cta.addEventListener('click', function () {
            emit('ad_click', el);
            beacon(el, 'click');
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
